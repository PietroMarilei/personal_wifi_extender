# Copy to extender.env and edit. extender.env is local and not meant to be shared.
# USB dongle only. The internal Wi-Fi (wlp0s20f3) is never touched.

CON_NAME=extender-usb
SSID=Personal-WiFi

# a = 5 GHz (channel 36). Use bg + 6 if a client is 2.4 GHz only.
# The PC uplink is already on 2.4 GHz channel 11, so 5 GHz avoids sharing that channel.
BAND=a
CHANNEL=36
